{
  "name": "@local/dsh-tide-whale-pet",
  "version": "2.6.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vertein-hy/super_blue_big_whale.git"
  },
  "homepage": "https://github.com/Vertein-hy/super_blue_big_whale#readme",
  "keywords": [
    "deepseek-harness",
    "desktop-pet",
    "cordis",
    "whale"
  ],
  "description": "Xixi, a three-outfit, nine-action blue whale desktop pet using the provided pack: original 24-frame walk/run to avoid RIFE leg warping, 96-frame RIFE for other actions, root-locked body.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "assets/**",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
